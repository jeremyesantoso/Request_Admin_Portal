PORT=5000

# TiDB Cloud Database
DB_HOST=your_tidb_host
DB_USER=your_tidb_user
DB_PASSWORD=your_tidb_password
DB_NAME=your_tidb_database
DB_PORT = your_tidb_PORT

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Admin Workspace Authentication
ADMIN_USER=cakekue_admin
ADMIN_PASS=your_secure_admin_password

# Nodemailer Email Invoicing
EMAIL_USER=your-bakery-email@gmail.com
EMAIL_PASS=your_gmail_app_password
ETRANSFER_EMAIL=your-etransfer-email@gmail.com